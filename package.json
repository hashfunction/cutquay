  "build": {
    "directories": {
      "buildResources": "build-resources"
    },
    "files": [
      "out/**/*",
      "LICENSE",
      "NOTICE",
      "licenses.txt",
      "Release/THIRD-PARTY-NOTICES.txt",
      "Release/ffmpeg-build.json",
      "Release/FFmpeg-LICENSE.txt"
    ],
    "asar": {
      "smartUnpack": false
    },
    "appId": "com.trieflow.cutquay",
    "artifactName": "${productName}-${os}-${arch}.${ext}",
    "extraResources": [
      {
        "from": "locales",
        "to": "locales"
      }
    ],
    "mac": {
